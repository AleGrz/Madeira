+/* iOS does not get the same Metal feature level as the macOS release it shares a
+ * year with, and the caller cannot tell the difference: DeviceImpl derives its
+ * request from the raw OS major number returned by WMTGetOSVersion, which on iOS
+ * is the iOS version. On iPadOS 16 that reads as ">= 15" and asks for Metal 3.2.
+ * AIR that declares a language version the on-device compiler does not know is
+ * rejected outright, and 3.2-only lowerings would not compile there either, so
+ * every entry point clamps its requested version through this.
+ * iOS 18 == macOS 15 (Metal 3.2), iOS 17 == macOS 14 (3.1), iOS 16 == 3.0. */
+inline SM50_SHADER_METAL_VERSION
+clamp_metal_version_to_host(SM50_SHADER_METAL_VERSION requested) {
+#if defined(__APPLE__) && TARGET_OS_IOS
+  if (__builtin_available(iOS 18.0, *))
+    return requested;
+  if (__builtin_available(iOS 17.0, *))
+    return requested > SM50_SHADER_METAL_310 ? SM50_SHADER_METAL_310 : requested;
+  return SM50_SHADER_METAL_300;
+#else
+  return requested;
+#endif
+}
