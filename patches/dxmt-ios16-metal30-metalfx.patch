+/* MetalFX only reached iOS in 18.0, and the app has to launch on iPadOS 16, so
+ * the framework is weak-linked there. Every entry point below that touches it
+ * asks first; with the framework absent the class references are nil and the
+ * queries answer "unsupported", which is what DXMT does with a device that
+ * cannot upscale anyway. */
+static bool metalfx_available(void) {
+#if TARGET_OS_IOS
+  if (@available(iOS 18.0, *))
+    return true;
+  return false;
+#else
+  return true;
+#endif
+}
