-  params->ret = [(id<MTLDevice>)params->handle supportsBCTextureCompression];
+  /* supportsBCTextureCompression only exists from iOS 16.4 / macOS 11; on an
+   * older device the selector raises rather than answering NO. The cached
+   * probe in to_metal_pixel_format() already asks this way. */
+  id<MTLDevice> bc_device = (id<MTLDevice>)params->handle;
